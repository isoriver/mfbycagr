# Public base URL of the deployed site (used for canonical URLs, sitemaps, OG tags).
NEXT_PUBLIC_SITE_URL=https://mutualfundsbycagr.com

# MFapi.in base (rarely needs changing).
MFAPI_BASE=https://api.mfapi.in

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset in dev/preview —
# analytics only load in a production build when this is present.
NEXT_PUBLIC_GA_ID=

# Fund-house logos (optional, build-time only — not exposed to the browser).
# `npm run build:logos` fetches AMC logos into public/logos/amc/ using this token.
# Get a free publishable token at https://logo.dev. Houses without a resolvable logo
# keep their initials avatar. (To use Brandfetch instead, set LOGO_URL_TEMPLATE with a
# "{domain}" placeholder and leave LOGO_DEV_TOKEN blank.)
LOGO_DEV_TOKEN=
# LOGO_URL_TEMPLATE=https://cdn.brandfetch.io/{domain}/w/128/h/128?c=YOUR_CLIENT_ID
